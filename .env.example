# Copy to .env. Never commit .env — it is gitignored.
#
# This file is the single source for these values. The launchd plists carry no
# JOBHUNT_DB: a plist value would beat .env (config._load_env uses setdefault),
# so editing here would silently do nothing to the agents while `make` picked the
# change up — two databases, no warning.

# --- database -----------------------------------------------------------------
# Absolute path, on a LOCAL disk. Never iCloud Drive, Dropbox, or any sync
# folder: WAL plus file-level sync corrupts the database, and db.connect()
# raises if the path looks synced.
#
# On the mini this is the external SSD. Nothing but `make migrate` will create a
# database, so a typo here fails loudly instead of quietly starting an empty
# second one.
JOBHUNT_DB=/Volumes/jobhunt/jobhunt.db

# Written to the volume by `./deploy/install.sh --init-volume`, which prints the
# value to paste here. With it set, a *different* disk mounted at the same path
# is refused rather than written to. Leave blank on a machine whose DB is on the
# boot volume — the check only applies under /Volumes.
JOBHUNT_DB_VOLUME_ID=

# NORMAL can lose the last transactions on power loss, and an external disk can
# also simply be unplugged. FULL costs one fsync per commit, which against a few
# hundred writes a day is free. Set FULL on the mini; the code default is NORMAL
# so dev and the tests stay fast.
JOBHUNT_SQLITE_SYNCHRONOUS=FULL

# --- dashboard ----------------------------------------------------------------
# Loopback only, and serve() raises on anything else. Reaching it from a laptop
# or phone is Tailscale Serve in front of this port:
#   tailscale serve --bg --https=443 http://127.0.0.1:8000
# That also gives you a real certificate, which is what makes the Fill helper's
# copy buttons work off this machine — navigator.clipboard needs a secure context.
JOBHUNT_HOST=127.0.0.1
JOBHUNT_PORT=8000

# --- backups and logs ---------------------------------------------------------
# Both on the INTERNAL disk. A backup on the same volume as the database
# protects against nothing, and a log has to be writable when that volume is
# gone — an agent that cannot say why it did nothing is worse than one that failed.
JOBHUNT_BACKUP_DIR=~/Library/Application Support/jobhunt/backups
JOBHUNT_LOG_DIR=~/Library/Logs/jobhunt

# --- your profile ---------------------------------------------------------------
# Defaults to docs/profile/ in the checkout. Point it elsewhere to keep a legal
# name, a phone number and a contact network out of the repository entirely.
JOBHUNT_PROFILE_DIR=

# --- anthropic (Phase 2+) -----------------------------------------------------
# Model per task lives in config/models.yaml, prompts in config/prompts/.
# Never a model ID here.
ANTHROPIC_API_KEY=

# --- gmail (Phase 5) ----------------------------------------------------------
# OAuth desktop-app client. Both files are gitignored.
GMAIL_CREDENTIALS=credentials.json
GMAIL_TOKEN=token.json

# --- escape hatch -------------------------------------------------------------
# Lets any process create the database instead of only `make migrate`. For
# first-time setup from a shell. Never put this in a plist.
# JOBHUNT_DB_CREATE=1
