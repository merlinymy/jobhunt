# Copy to .env. Never commit .env — it is gitignored.

# --- database -----------------------------------------------------------------
# Absolute path on the host's LOCAL disk. Never iCloud Drive, Dropbox, or any
# sync folder: WAL plus file-level sync corrupts the database. db.connect()
# raises if this path looks synced.
JOBHUNT_DB=~/code/jobhunt/jobhunt.db

# --- dashboard ----------------------------------------------------------------
# Loopback only. Cross-machine and phone access is Tailscale, never a bind
# address. run_dev() raises on anything that is not a loopback address.
JOBHUNT_HOST=127.0.0.1
JOBHUNT_PORT=8000

# --- anthropic (Phase 2+) -----------------------------------------------------
# Model per task lives in config/models.yaml. Never a model ID here.
ANTHROPIC_API_KEY=

# --- telegram (Phase 4) -------------------------------------------------------
# Long polling. No webhook, no port forward, no static IP.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- gmail (Phase 5) ----------------------------------------------------------
# OAuth desktop-app client. Both files are gitignored.
GMAIL_CREDENTIALS=credentials.json
GMAIL_TOKEN=token.json
