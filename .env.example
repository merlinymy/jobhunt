# Copy to .env. Never commit .env — it is gitignored.
#
# This file is the single source for these values. The launchd plists carry no
# JOBHUNT_DB: a plist value would beat .env (config._load_env uses setdefault),
# so editing here would silently do nothing to the agents while `make` picked the
# change up — two databases, no warning.

# --- database -----------------------------------------------------------------
# LEAVE THIS COMMENTED OUT unless you want the database somewhere specific.
# Unset, it defaults to `jobhunt.db` in the repository root, which is gitignored
# and needs no external disk. That is the right answer for most people.
#
# If you do set it: an absolute path on a LOCAL disk. Never iCloud Drive,
# Dropbox, or any sync folder — WAL plus file-level sync corrupts the database,
# and db.connect() raises if the path looks synced.
#
# Nothing but `make migrate` will create a database, so a typo here fails loudly
# instead of quietly starting an empty second one.
#
# JOBHUNT_DB=~/jobhunt/jobhunt.db          # somewhere outside the checkout
# JOBHUNT_DB=/Volumes/jobhunt/jobhunt.db   # an external disk — read the next note

# ONLY relevant if JOBHUNT_DB points under /Volumes. Such a path gets three extra
# checks, because an unmounted /Volumes path is still a writable path on the boot
# volume: opening it there would create a decoy database that goes silently
# missing the moment the real disk mounts beside it.
# Run `./deploy/install.sh --init-volume` once with the disk mounted; it prints
# the value to paste here, which stamps that specific disk so a *different* one
# mounted at the same path is refused. Leave blank otherwise.
JOBHUNT_DB_VOLUME_ID=

# NORMAL can lose the last few transactions on power loss. FULL costs one fsync
# per commit, which against a few hundred writes a day is free — worth setting on
# an always-on host, and especially on an external disk that can be unplugged.
# Commented out means NORMAL, which keeps dev and the tests fast.
# JOBHUNT_SQLITE_SYNCHRONOUS=FULL

# --- dashboard ----------------------------------------------------------------
# Loopback only, and serve() raises on anything else. Reaching it from a laptop
# or phone is Tailscale Serve in front of this port:
#   tailscale serve --bg --https=443 http://127.0.0.1:8000
# That also gives you a real certificate, which is what makes the Fill helper's
# copy buttons work off this machine — navigator.clipboard needs a secure context.
JOBHUNT_HOST=127.0.0.1
JOBHUNT_PORT=8000

# --- backups and logs ---------------------------------------------------------
# Both on the INTERNAL disk. A backup on the same volume as the database
# protects against nothing, and a log has to be writable when that volume is
# gone — an agent that cannot say why it did nothing is worse than one that failed.
JOBHUNT_BACKUP_DIR=~/Library/Application Support/jobhunt/backups
JOBHUNT_LOG_DIR=~/Library/Logs/jobhunt

# --- your profile ---------------------------------------------------------------
# Defaults to docs/profile/ in the checkout. Point it elsewhere to keep a legal
# name, a phone number and a contact network out of the repository entirely.
JOBHUNT_PROFILE_DIR=

# --- anthropic (Phase 2+) -----------------------------------------------------
# Model per task lives in config/models.yaml, prompts in config/prompts/.
# Never a model ID here.
ANTHROPIC_API_KEY=

# --- gmail (Phase 5) ----------------------------------------------------------
# OAuth desktop-app client. Both files are gitignored.
GMAIL_CREDENTIALS=credentials.json
GMAIL_TOKEN=token.json

# --- escape hatch -------------------------------------------------------------
# Lets any process create the database instead of only `make migrate`. For
# first-time setup from a shell. Never put this in a plist.
# JOBHUNT_DB_CREATE=1
